# ============================================================
# AiMediaMaker 环境配置模板
# 复制本文件为 .env 并填写所有必填项
# ============================================================

# ------------------- 应用配置 -------------------
# 应用名称 (可选)
APP_NAME=AiMediaMaker

# 应用版本 (可选)
APP_VERSION=1.0.0

# 调试模式 (开发环境=true, 生产环境=false)
DEBUG=true

# JWT密钥 (生产环境必须修改为随机长字符串)
SECRET_KEY=change-me-in-production-please-use-a-random-string

# 前端跨域来源 (开发环境默认值)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ------------------- 数据库 -------------------
# SQLite异步连接URL (通常无需修改)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ------------------- Redis -------------------
# Redis连接URL (必填)
REDIS_URL=redis://localhost:6379/0

# ------------------- 文件存储 -------------------
# 本地存储路径 (通常无需修改)
STORAGE_PATH=./storage

# 最大上传文件大小 (默认100MB)
MAX_UPLOAD_SIZE=104857600

# ------------------- 认证 -------------------
# Token有效期 (默认7天，单位: 分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------- 任务队列 -------------------
# 任务状态轮询间隔 (默认30秒)
TASK_POLL_INTERVAL=30

# 任务最大重试次数
TASK_MAX_RETRIES=3

# ------------------- 火山方舟API (必填) -------------------
# 方舟API基础URL (通常无需修改)
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 方舟API Key (从 https://console.volcengine.com/ark/region:ark+cn-beijing/apikey 获取)
ARK_API_KEY=

# ------------------- TOS对象存储 (必填) -------------------
# ⚠️ 警告: TOS是平台运行的必选项！
# 没有TOS配置，用户上传的文件无法转换为公网URL，
# 也就无法传递给火山方舟API进行多模态生成。
#
# 配置获取方式:
# 1. 登录 https://console.volcengine.com
# 2. 进入 "对象存储TOS" → 创建Bucket (推荐地域: 北京)
# 3. 进入 "访问控制" → 密钥管理 → 创建AK/SK
# 4. 确保AK/SK有该Bucket的读写权限

# TOS服务端点 (北京: tos-cn-beijing.volces.com)
TOS_ENDPOINT=tos-cn-beijing.volces.com

# TOS Access Key ID (必填)
TOS_ACCESS_KEY=

# TOS Secret Access Key (必填)
TOS_SECRET_KEY=

# TOS Bucket名称 (必填)
TOS_BUCKET=

# TOS地域 (必填)
TOS_REGION=cn-beijing

# 预签名URL有效期 (默认7天，单位: 秒)
TOS_EXPIRES=604800
